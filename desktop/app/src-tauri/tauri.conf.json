{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalDNS",
  "version": "0.2.2",
  "identifier": "com.localdns.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-sidecars.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LocalDNS",
        "width": 1000,
        "height": 660,
        "minWidth": 800,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Wildcard DNS for local development",
    "longDescription": "LocalDNS answers wildcard DNS zones like *.myapp.test with addresses you configure, and registers those zones with the operating system's resolver.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQTk3MkYyQ0E1OEYyMQpSV1FoajZVc0w1ZmFDc1AxQ1dhNmVmaEJ0WjloRTRrQXVSR0NLdXhNZC95NFg2SEVLOHQ4NUlpNgo=",
      "endpoints": [
        "https://github.com/sibidharan/localdns/releases/latest/download/latest.json"
      ]
    }
  }
}
